end)

-- 5) Vold TP Click (Random teleport loop every 0.2s)
VoldTpBtn.MouseButton1Click:Connect(function()
    isVoldTpActive = not isVoldTpActive
    if isVoldTpActive then
        VoldTpBtn.Text = "vold tp: ON"
        VoldTpBtn.BackgroundColor3 = Color3.fromRGB(100, 40, 150)
        task.spawn(function()
            while isVoldTpActive do
                task.wait(0.2)
                if not isVoldTpActive then break end
                local allPlayers = Players:GetPlayers()
                local others = {}
                for _, p in ipairs(allPlayers) do
                    if p ~= LocalPlayer then
                        table.insert(others, p)
                    end
                end
                if #others > 0 then
                    local randomTarget = others[math.random(1, #others)]
                    if randomTarget.Character and randomTarget.Character:FindFirstChild("HumanoidRootPart") then
                        local myChar = LocalPlayer.Character
                        if myChar and myChar:FindFirstChild("HumanoidRootPart") then
                            myChar.HumanoidRootPart.CFrame = randomTarget.Character.HumanoidRootPart.CFrame * CFrame.new(math.random(-2, 2), 0, math.random(-2, 2))
                        end
                    end
                end
            end
        end)
    else
        VoldTpBtn.Text = "vold tp: OFF"
        VoldTpBtn.BackgroundColor3 = Color3.fromRGB(32, 32, 40)
    end
end)

-- 6) Lag Mode Click (Simulates lagging/stuttering movement)
LagModeBtn.MouseButton1Click:Connect(function()
    isLagModeActive = not isLagModeActive
    if isLagModeActive then
        LagModeBtn.Text = "Lag Mode: ON"
        LagModeBtn.BackgroundColor3 = Color3.fromRGB(180, 80, 0)
        task.spawn(function()
            while isLagModeActive do
                task.wait(0.18)
                if not isLagModeActive then break end
                local myChar = LocalPlayer.Character
                if myChar and myChar:FindFirstChild("HumanoidRootPart") then
                    local hrp = myChar.HumanoidRootPart
                    local offset = Vector3.new(math.random(-4, 4), 0, math.random(-4, 4))
                    hrp.CFrame = hrp.CFrame + offset
                    task.wait(0.1)
                    if not isLagModeActive then break end
                    hrp.CFrame = hrp.CFrame - offset
                end
            end
        end)
    else
        LagModeBtn.Text = "Lag Mode: OFF"
        LagModeBtn.BackgroundColor3 = Color3.fromRGB(32, 32, 40)
    end
end)

-- Player Events
Players.PlayerAdded:Connect(refreshPlayerList)
Players.PlayerRemoving:Connect(function(player)
    if selectedPlayer == player then
        selectedPlayer = nil
        TpBtn.Text = "TP (No User Selected)"
        TpBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
    end
    refreshPlayerList()
end)
