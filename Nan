--- [ Logic Implementation ] ---

local selectedPlayer = nil
local isFrozen = false
local isVoldTpActive = false
local isLagModeActive = false

-- Toggle UI Visibility
ToggleBtn.MouseButton1Click:Connect(function()
    MainFrame.Visible = not MainFrame.Visible
    ToggleBtn.Text = MainFrame.Visible and "Close UI" or "Toggle UI"
end)

-- Refresh Player List
local function refreshPlayerList()
    for _, child in ipairs(PlayerListFrame:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local pBtn = Instance.new("TextButton")
            pBtn.Size = UDim2.new(1, -8, 0, 26)
            pBtn.BackgroundColor3 = Color3.fromRGB(28, 28, 35)
            pBtn.Text = "  " .. player.DisplayName .. " (@" .. player.Name .. ")"
            pBtn.TextColor3 = Color3.fromRGB(230, 230, 230)
            pBtn.Font = Enum.Font.Gotham
            pBtn.TextSize = 12
            pBtn.TextXAlignment = Enum.TextXAlignment.Left
            pBtn.Parent = PlayerListFrame

            local pCorner = Instance.new("UICorner")
            pCorner.CornerRadius = UDim.new(0, 4)
            pCorner.Parent = pBtn

            pBtn.MouseButton1Click:Connect(function()
                selectedPlayer = player
                TpBtn.Text = "TP -> " .. player.DisplayName
                TpBtn.TextColor3 = Color3.fromRGB(0, 255, 170)
                
                for _, btn in ipairs(PlayerListFrame:GetChildren()) do
                    if btn:IsA("TextButton") then
                        btn.BackgroundColor3 = Color3.fromRGB(28, 28, 35)
                    end
                end
                pBtn.BackgroundColor3 = Color3.fromRGB(45, 75, 65)
            end)
        end
    end
    PlayerListFrame.CanvasSize = UDim2.new(0, 0, 0, UIListLayout.AbsoluteContentSize.Y)
end

-- 1) Bobo Mos Click
BoboMosBtn.MouseButton1Click:Connect(function()
    LocalPlayer.CameraMode = Enum.CameraMode.LockFirstPerson
    PlayerListFrame.Visible = true
    refreshPlayerList()
end)

-- 2) TP Click
TpBtn.MouseButton1Click:Connect(function()
    if selectedPlayer and selectedPlayer.Character and selectedPlayer.Character:FindFirstChild("HumanoidRootPart") then
        local myChar = LocalPlayer.Character
        if myChar and myChar:FindFirstChild("HumanoidRootPart") then
            myChar.HumanoidRootPart.CFrame = selectedPlayer.Character.HumanoidRootPart.CFrame * CFrame.new(0, 0, 3)
        end
    else
        TpBtn.Text = "TP (Target Character Not Found)"
    end
end)

-- 3) Freeze Click
FreezeBtn.MouseButton1Click:Connect(function()
    isFrozen = not isFrozen
    local myChar = LocalPlayer.Character
    if myChar and myChar:FindFirstChild("HumanoidRootPart") then
        myChar.HumanoidRootPart.Anchored = isFrozen
    end
    
    if isFrozen then
        FreezeBtn.Text = "Freeze: ON"
        FreezeBtn.BackgroundColor3 = Color3.fromRGB(0, 120, 200)
        FreezeBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    else
        FreezeBtn.Text = "Freeze: OFF"
        FreezeBtn.BackgroundColor3 = Color3.fromRGB(32, 32, 40)
        FreezeBtn.TextColor3 = Color3.fromRGB(100, 200, 255)
    end
end)

-- 4) Other Ban Click
